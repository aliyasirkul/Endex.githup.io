<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <title>Ana Sayfa</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      display: flex;
      justify-content: space-around;
      margin: 20px;
    }
    .section {
      width: 45%;
      padding: 20px;
      border: 2px solid #333;
      border-radius: 10px;
      background-color: #f9f9f9;
    }
    h2 {
      text-align: center;
    }
    button {
      display: block;
      margin: 10px auto;
      padding: 10px 20px;
      font-size: 16px;
      cursor: pointer;
    }
    .question {
      margin: 15px 0;
    }
  </style>
</head>
<body>
  <!-- Hakkımda Bölümü -->
  <div class="section">
    <h2>Hakkımda</h2>
    <p>Adım: <strong>Ali Yasir Kul</strong></p>
    <p>En sevdiğim dersler: Matematik, İngilizce, Bilişim Teknoloji</p>
    <p>İlkokulun yarısını Devran Koleji adlı okulda okudum.</p>
    <p>Şu anda Acıbadem Okulu'nda 6. sınıfa gidiyorum.</p>
    <p>Servisle gidip gelirken evlere ve araçlara bakmayı seviyorum.</p>
  </div>

  <!-- Quiz Bölümü -->
  <div class="section">
    <h2>Quiz</h2>
    <button onclick="startQuiz('matematik')">Matematik Testi</button>
    <button onclick="startQuiz('ingilizce')">İngilizce Testi</button>
    <div id="quiz"></div>
  </div>

  <script>
    const quizzes = {
      matematik: [
        "1) 12 x 8 kaçtır?",
        "2) Bir üçgenin iç açıları toplamı kaç derecedir?",
        "3) 5/10 kesirinin sadeleşmiş hali nedir?",
        // ... toplam 15 soru eklenebilir
      ],
      ingilizce: [
        "1) 'Apple' kelimesinin Türkçesi nedir?",
        "2) 'I am 12 years old' cümlesi ne anlama gelir?",
        "3) 'Teacher' kelimesi ne demektir?",
        // ... toplam 15 soru eklenebilir
      ]
    };

    function startQuiz(subject) {
      const quizDiv = document.getElementById("quiz");
      quizDiv.innerHTML = "";
      quizzes[subject].forEach(q => {
        const p = document.createElement("p");
        p.className = "question";
        p.textContent = q;
        quizDiv.appendChild(p);
      });
    }
  </script>
</body>
</html>
